{
  "name": "jsx-prop-lookup-mcp-server",
  "version": "5.0.0",
  "description": "MCP v2 server for analyzing JSX prop usage using AST",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "keywords": [
    "mcp",
    "jsx",
    "react",
    "ast",
    "props",
    "analysis",
    "typescript"
  ],
  "author": "Rovo Dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmn451/jsx-prop-lookup-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/lmn451/jsx-prop-lookup-mcp-server/issues"
  },
  "homepage": "https://github.com/lmn451/jsx-prop-lookup-mcp-server#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:mutation": "stryker run",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test",
    "test:mutation:project": "stryker run stryker.project.config.json",
    "test:mutation:find": "stryker run stryker.find-jsx.config.json",
    "test:mutation:check": "stryker run stryker.check-jsx.config.json",
    "test:mutation:inspect": "stryker run stryker.inspect.config.json",
    "test:mutation:impact": "stryker run stryker.impact.config.json"
  },
  "bin": {
    "jsx-prop-lookup-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/index.*",
    "dist/server.*",
    "dist/jsx-analyzer.*",
    "dist/jsx-query.*",
    "dist/find-jsx.*",
    "dist/inspect-component.*",
    "dist/version.*",
    "dist/results.*",
    "dist/project.*",
    "dist/cli.*",
    "dist/legacy-server.*",
    "docs/cli.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "package.json",
    "docs/find-jsx.md",
    "dist/check-jsx.*",
    "docs/check-jsx.md",
    "dist/saved-checks.*",
    "docs/saved-checks.md",
    "docs/inspect-component.md",
    "examples/audit",
    "dist/change-impact.*",
    "docs/change-impact.md",
    "docs/legacy-analysis.md",
    "docs/ast-modernization.md",
    "docs/dependency-migrations.md",
    "docs/ast-parser-benchmark.json"
  ],
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "glob": "^14.0.4",
    "ignore": "^7.0.14",
    "typescript": "6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.5"
    },
    "@stryker-mutator/core@^10.1.1": {
      "minimatch": "11.0.5",
      "typed-rest-client": {
        "qs": "6.17.1"
      }
    },
    "@stryker-mutator/tap-runner@^10.1.1": {
      "glob": "14.0.4"
    }
  }
}
