{
  "name": "jsx-prop-lookup-mcp-server",
  "version": "4.0.0",
  "description": "MCP v2 server for analyzing JSX prop usage using AST",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "jsx",
    "react",
    "ast",
    "props",
    "analysis",
    "typescript"
  ],
  "author": "Rovo Dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmn451/jsx-prop-lookup-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/lmn451/jsx-prop-lookup-mcp-server/issues"
  },
  "homepage": "https://github.com/lmn451/jsx-prop-lookup-mcp-server#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "bin": {
    "jsx-prop-lookup-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@modelcontextprotocol/server": "^2.0.0",
    "glob": "^13.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
