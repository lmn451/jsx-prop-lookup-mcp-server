{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/inspect-component.ts"],
  "ignorePatterns": ["/mcp.json"],
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/inspect-component.test.js",
      "tests/inspect-component.mcp.test.js",
      "tests/inspect-component.review.test.js"
    ]
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/inspect-mutation/report.json"
  },
  "htmlReporter": {
    "fileName": "reports/inspect-mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 90
  },
  "concurrency": 2,
  "buildCommand": "npm run build"
}
