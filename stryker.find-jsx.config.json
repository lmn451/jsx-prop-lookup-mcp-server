{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/jsx-query.ts", "src/find-jsx.ts"],
  "ignorePatterns": ["/mcp.json"],
  "testRunner": "tap",
  "tap": {
    "testFiles": ["tests/find-jsx.test.js", "tests/find-jsx-security.test.js"]
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/find-jsx.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/find-jsx.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 90
  },
  "concurrency": 2,
  "buildCommand": "npm run build",
  "incrementalFile": "reports/mutation/find-jsx-incremental.json"
}
